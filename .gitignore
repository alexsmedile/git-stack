.DS_Store
**/.DS_Store
output/*
!output/.gitkeep
_backups/
_archive/
.env
.env.*

# Machine-local tool state — not part of the bundle.
# .spectacular/ itself IS tracked; only the .local/ sidecar is ignored.
.octopus/
.spectacular.local/

# Personal local companions (make-a-change OPF §3.5) — never committed.
*.local.*
.octopus.local/
*.local/

# Drafts, not distributed with the skill bundle
articles/
.spectacular/transactions/

# Local-only: backups, snapshots, scratch — never committed
_snapshots/
_local/
